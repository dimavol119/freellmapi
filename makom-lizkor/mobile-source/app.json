{
  "expo": {
    "name": "מקום לזכור",
    "slug": "makom-lizkor",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "scheme": "makom-lizkor",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleLocalizations": [
          "he",
          "en",
          "ru"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.makomlizkor.app"
    },
    "android": {
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "package": "com.makomlizkor.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f3ede3"
      }
    },
    "web": {
      "name": "מקום לזכור",
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "themeColor": "#f3ede3",
      "backgroundColor": "#f3ede3",
      "lang": "he"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "בחר תמונות וצילומי מסך שתרצה לשמור בזיכרונות שלך.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#f6a15b"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "backgroundColor": "#f3ede3",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f3ede3"
    }
  }
}
